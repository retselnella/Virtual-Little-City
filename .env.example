# Copy to .env.local (git-ignored) to turn on online play. See README section 14.
# Both values are public: use the publishable (or anon public) key, never the secret / service_role key.
# The VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY names also work.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
